{
  "name": "my-mac-manager",
  "version": "0.1.0",
  "description": "Manage a headless Mac (mini, EC2 Mac) from another machine: status, control, backup, reboot, bootstrap. Pluggable vault, backup and service checks.",
  "type": "module",
  "bin": {
    "m3": "dist/m3.js"
  },
  "exports": {
    "./plugin": {
      "types": "./dist/types/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "PLUGINS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "backup",
    "bitwarden",
    "filevault",
    "homelab",
    "launchd",
    "m3-plugin",
    "mac",
    "mac-mini",
    "restic"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obov/my-mac-manager.git"
  },
  "homepage": "https://github.com/obov/my-mac-manager#readme",
  "bugs": {
    "url": "https://github.com/obov/my-mac-manager/issues"
  },
  "author": "Mark (https://github.com/obov)"
}
